@Metadata.layer: #CUSTOMER
annotate entity ZFI_APP1_SCPV
    with 
{
  @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Standard Items',
                   position:        10 } ]
  @UI.hidden: true
Uuid;
  @UI: { lineItem: [{ position: 10, label: 'Purchase Order' }],
  identification: [{ position: 10, label: 'Purchase Order'  }] }
  @EndUserText.label: 'Purchase Order'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZFI_POITEM_VH', element: 'PurchaseOrder' },
                    additionalBinding: [{ localElement: 'Poitem', element: 'PurchaseOrderItem', usage: #RESULT },
                                    { localElement: 'Materialnumber', element: 'Material', usage: #RESULT },
                                    { localElement: 'Productdes', element: 'Productdes', usage: #RESULT },
                                    { localElement: 'Poqty', element: 'Poqty', usage: #RESULT },
                                    { localElement: 'Pounit', element: 'Pounit', usage: #RESULT }]  }]
Poorder;
  @UI: { lineItem: [{ position: 20, label: 'Purchase Order Item' }],
  identification: [{ position: 20, label: 'Purchase Order Item'  }] }
  @EndUserText.label: 'Purchase Order Item'
Poitem;
  @UI: { lineItem: [{ position: 30, label: 'Product' }],
  identification: [{ position: 30, label: 'Product'  }] }
  @EndUserText.label: 'Product'
Materialnumber;
  @UI: { lineItem: [{ position: 40, label: 'Product Des' }],
  identification: [{ position: 40, label: 'Product Des'  }] }
  @EndUserText.label: 'Product Des'
Productdes;
  @UI: { lineItem: [{ position: 50, label: 'Quantity' }],
  identification: [{ position: 50, label: 'Quantity'  }] }
  @EndUserText.label: 'Quantity'
Poqty;
  @UI: { lineItem: [{ position: 60, label: 'UOM' }],
  identification: [{ position: 60, label: 'UOM'  }] }
  @EndUserText.label: 'UOM'
Pounit;
  @UI: { lineItem: [{ position: 70, label: 'Purchase Cost' }],
  identification: [{ position: 70, label: 'Purchase Cost'  }] }
  @EndUserText.label: 'Purchase Cost'
Pocost;
  @UI: { lineItem: [{ position: 80, label: 'Document Currency' }],
  identification: [{ position: 80, label: 'Document Currency'  }] }
  @EndUserText.label: 'Document Currency'
Documcurrency;
