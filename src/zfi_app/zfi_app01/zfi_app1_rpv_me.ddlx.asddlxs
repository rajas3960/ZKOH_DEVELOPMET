@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'RGP/NRGP - Transfer Process',
typeNamePlural: 'RGP/NRGP - Transfer Process',
title: { type: #STANDARD, value: 'Gpnum' },
         description: { type: #STANDARD, value: 'Gptype' }  } }
annotate entity ZFI_APP1_RPV
    with 
{
  @UI.facet: [ { id:              'Header',
                          purpose:         #STANDARD,
                          type:            #IDENTIFICATION_REFERENCE,
                          label:           'RGP/NRGP - Transfer Basic Detials',
                          position:        10 } ,
//This one Normal Asset Transfer Line item
                        { id:              'Items',
                          purpose:         #STANDARD,
                          type:            #LINEITEM_REFERENCE,
                          label:           'Asset Line Items',
                          position:        20,
                          targetElement:   '_Item'},
//This one Purchase Line item                      
                        { id:              'WorkItem',
                          purpose:         #STANDARD,
                          type:            #LINEITEM_REFERENCE,
                          label:           'Work Order Line Items',
                          position:        30,
                          targetElement:   '_Work'}    
                          ]

  @UI.hidden: true
Uuid;
@UI:{ lineItem: [{ position: 10, label: 'RGP/NRGP No' }],
      identification: [{ position: 10, label: 'RGP/NRGP No' },
       { type: #FOR_ACTION, dataAction: 'GateStatus', label: 'Trasnfer', position: 10 }] }  
@UI.selectionField: [{ position: 10 }]
@EndUserText.label: 'RGP/NRGP No'
Gpnum;
@UI:{ lineItem: [{ position: 20, label: 'RGP/NRGP Type' }],
      identification: [{ position: 20, label: 'RGP/NRGP Type' }] }  
@UI.selectionField: [{ position: 20 }]
@Consumption.valueHelpDefinition: [{ entity:{ name: 'ZFI_GPTYPE_VH',
                                    element: 'value_low' }, distinctValues: true }]
@EndUserText.label: 'RGP/NRGP Type'
Gptype;
@UI:{ lineItem: [{ position: 25, label: 'Work Process' }],
      identification: [{ position: 25, label: 'Work Process' }] }  
@Consumption.valueHelpDefinition: [{ entity:{ name: 'ZFI_WORK_PROCESS_VH',
                                    element: 'value_low' }, distinctValues: true }]
@EndUserText.label: 'Work Process'
Workprocess;
  @UI: { lineItem: [{ position: 30, label: 'Posting Date'}],
    identification: [{ position: 30, label: 'Posting Date' }]}
  @EndUserText.label: 'Posting Date'
Postingdate;
  @UI: { lineItem: [{ position: 40, label: 'Document date'}],
    identification: [{ position: 40, label: 'Document date' }]}
  @EndUserText.label: 'Document date'
Documentdate;
    @UI: { lineItem: [{ position: 50, label: 'Plant' }],
            identification: [{ position: 50, label: 'Plant' }] }
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_PlantStdVH', element: 'Plant' } }]    
  @EndUserText.label: 'Plant'  
Plant;
  @UI: { lineItem: [{ position: 60, label: 'Prepared by'}],
    identification: [{ position: 170, label: 'Prepared by' }]}
  @EndUserText.label: 'Prepared by'
Createdby;
  @UI.identification: [{ position: 60, label: 'Gate' }]
  @EndUserText.label: 'Gate'  
Gate;
  @UI.identification: [{ position: 70, label: 'Carried By' }]
  @EndUserText.label: 'Carried By'  
Carriedby;
  @UI.identification: [{ position: 80, label: 'Last Invoice No' }]
  @EndUserText.label: 'Last Invoice No'  
Lastinvno;
  @UI.identification: [{ position: 90, label: 'Register No' }]
  @EndUserText.label: 'Register No'  
Registerno;
  @UI.identification: [{ position: 100, label: 'Reference No' }]
  @EndUserText.label: 'Reference No'  
Refno;
  @UI.identification: [{ position: 110, label: 'Date' }]
  @EndUserText.label: 'Date'  
Refbldate;
  @UI.identification: [{ position: 120, label: 'Location' }]
  @EndUserText.label: 'Location'  
Location;
  @UI.identification: [{ position: 130, label: 'Going Where' }]
  @EndUserText.label: 'Going Where'  
Goingwhere;
  @UI.identification: [{ position: 140, label: 'GSTIN' }]
  @EndUserText.label: 'GSTIN'  
Gstin;
  @UI.identification: [{ position: 150, label: 'Work Order No' }]
  @EndUserText.label: 'Work Order No'  
  @Consumption.valueHelpDefinition: [{ entity:{ name: 'ZFI_PO_VH',element: 'PurchaseOrder' }, 
                        additionalBinding: [{ localElement: 'Suppilername', element: 'BPSupplierFullName', usage: #RESULT }]
                         }]  
Workorderno;
  @UI.identification: [{ position: 160, label: 'Suppiler Name' }]
  @EndUserText.label: 'Suppiler Name'  
Suppilername;

  @UI.identification: [{ position: 180, label: 'Remarks (Reason for Transfer)' }]
  @EndUserText.label: 'Remarks (Reason for Transfer)'  
Remarks;  
  @UI.identification: [{ position: 190, label: 'WDV' }]
  @EndUserText.label: 'WDV'
Wdv;  
  @UI:{ lineItem: [{ position: 70, label: 'Trasnfer Status' }],
  identification: [{ position: 200, label: 'Trasnfer Status' }] }
  @EndUserText.label: 'Trasnfer Status'  
statustext;
@UI.identification: [{ position: 210, label: 'Challan No' }]
@UI.lineItem: [{ position: 80, label: 'Challan No' }]
@EndUserText.label: 'Challan No'
Challanno;
