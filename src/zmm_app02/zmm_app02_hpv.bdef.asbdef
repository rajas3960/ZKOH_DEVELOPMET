projection;
strict(2);
use draft;

define behavior for ZMM_APP02_hpv alias _hdr
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action upexl;

  use association _ITEM { create; with draft; }
}

define behavior for ZMM_APP02_IPV alias _item//alias <alias_name>
{
  use update;
  use delete;

  use association _HDR { with draft; }
}