projection;
strict ( 2 );
use draft;

define behavior for ZFI_APP1_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action GateStatus;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
  use association _Work { create; with draft; }
}

define behavior for ZFI_APP1_CPIV //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}

define behavior for ZFI_APP1_SCPV //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}