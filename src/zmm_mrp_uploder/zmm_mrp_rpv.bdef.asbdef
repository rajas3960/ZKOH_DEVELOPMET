projection;
strict ( 2 );
use draft;
use side effects;
define behavior for ZMM_MRP_RPV //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action CrtPr;
  use action UpdPr;
    use action CrtPo;

  use action loadexcel;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;
    side effects { action loadexcel affects entity _items ;}
  use association _Items { create;with draft; }
  use association _Pritm { create; with draft; }
}

define behavior for ZMM_MRP_IPV1 //alias <alias_name>
{
  use update;
  use delete;

  use association _header{with draft;}
}

define behavior for ZMM_MRP_IPV2 //alias <alias_name>
{
  use update;
  use delete;

  use association _header{with draft;}
}